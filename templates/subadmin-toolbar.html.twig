{#
/**
 * @file
 * Template for the Subadmin Toolbar.
 *
 * Available variables:
 * - links: Nested menu links (id, title, url, icon, icon_type, below).
 * - widgets: Render arrays of the block widgets.
 * - toolbar_title: Brand title.
 * - toolbar_icon_url: URL of the uploaded brand icon, if any.
 * - accent_color: Validated hex accent color.
 * - toolbar_title_link: URL the brand links to.
 * - hide_icon: Whether the brand icon is hidden.
 */
#}
{% macro render_icon(link) %}
  {% if link.icon %}
    {% if link.icon_type starts with 'material' %}
      <span class="subadmin-toolbar-icon {{ link.icon_type }}" translate="no">{{ link.icon }}</span>
    {% else %}
      <span class="subadmin-toolbar-icon">
        <i class="{{ link.icon_type }} {{ link.icon }}" aria-hidden="true"></i>
      </span>
    {% endif %}
  {% endif %}
{% endmacro %}

{% macro render_menu_items(items, is_root) %}
  {% import _self as macros %}
  {% for link in items %}
    <li class="{{ is_root ? 'subadmin-toolbar-item' : 'subadmin-toolbar-subitem' }}{{ link.below ? ' has-submenu' }}">
      <a href="{{ link.url }}" class="{{ is_root ? 'subadmin-toolbar-link' : 'subadmin-toolbar-sublink' }}">
        {{ macros.render_icon(link) }}
        <span class="subadmin-toolbar-text">{{ link.title }}</span>
        {% if link.below %}
          <span class="subadmin-toolbar-caret material-symbols-outlined" translate="no" aria-hidden="true">{{ is_root ? 'expand_more' : 'chevron_right' }}</span>
        {% endif %}
      </a>
      {% if link.below %}
        <ul class="subadmin-toolbar-submenu">
          {{ macros.render_menu_items(link.below, false) }}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
{% endmacro %}
{% import _self as macros %}

{% if links or widgets %}
  <div id="subadmin-toolbar" class="subadmin-toolbar gin-like-toolbar" role="navigation" aria-label="{{ 'Subadmin toolbar'|t }}" style="--subadmin-toolbar-toggle-hover-color: {{ accent_color }}; --subadmin-toolbar-accent: {{ accent_color }};">
    <div class="subadmin-toolbar-inner">
      {% set brand %}
        {% if not hide_icon %}
          <span class="subadmin-toolbar-logo">
            {% if toolbar_icon_url %}
              <img src="{{ toolbar_icon_url }}" alt="" class="subadmin-toolbar-logo-img">
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 11a2 2 0 1 1-4 0 4 4 0 0 1 8 0 6 6 0 0 1-12 0 8 8 0 0 1 16 0 10 10 0 1 1-20 0 11.93 11.93 0 0 1 2.42-7.22 2 2 0 1 1 3.16 2.44"/></svg>
            {% endif %}
          </span>
        {% endif %}
        {% if toolbar_title %}
          <span class="subadmin-toolbar-title">{{ toolbar_title }}</span>
        {% endif %}
      {% endset %}

      <div class="subadmin-toolbar-brand">
        {% if toolbar_title_link %}
          <a href="{{ toolbar_title_link }}" class="subadmin-toolbar-title-link">{{ brand }}</a>
        {% else %}
          {{ brand }}
        {% endif %}
      </div>

      <div id="subadmin-toolbar-collapse" class="subadmin-toolbar-collapse">
        {% if links %}
          <ul id="subadmin-toolbar-menu" class="subadmin-toolbar-menu">
            {{ macros.render_menu_items(links, true) }}
          </ul>
        {% endif %}

        {% if widgets %}
          <div class="subadmin-toolbar-widgets">
            {% for widget in widgets %}
              {{ widget }}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <button type="button" class="subadmin-toolbar-toggle" aria-expanded="false" aria-controls="subadmin-toolbar-collapse" aria-label="{{ 'Toggle menu'|t }}">
        <span class="subadmin-toolbar-toggle-icon" translate="no"></span>
      </button>
    </div>
  </div>
{% endif %}
