{#
/**
 * @file
 * Template for the Subadmin Toolbar.
 *
 * Available variables:
 * - links: Nested menu links (id, title, url, icon, icon_type, below).
 * - widgets: Render arrays of the block widgets.
 * - toolbar_title: Brand title.
 * - toolbar_icon_url: URL of the uploaded brand icon, if any.
 * - accent_color: Validated hex accent color.
 * - toolbar_title_link: URL the brand links to.
 * - hide_icon: Whether the brand icon is hidden.
 * - style_vars: Validated CSS custom properties (name => value) for the style
 *   attribute.
 * - appearance: Validated appearance flags: indicator (caret, plus_minus or
 *   none), submenu_icons (whether icons show inside submenus), position (top,
 *   left or right), sidebar_mode (fixed or collapsible) and
 *   sidebar_start_collapsed (whether the sidebar starts collapsed).
 */
#}
{% macro render_icon(link) %}
  {% if link.icon %}
    {% if link.icon_type starts with 'material' %}
      <span class="subadmin-toolbar-icon {{ link.icon_type }}" translate="no">{{ link.icon }}</span>
    {% else %}
      <span class="subadmin-toolbar-icon">
        <i class="{{ link.icon_type }} {{ link.icon }}" aria-hidden="true"></i>
      </span>
    {% endif %}
  {% else %}
    <span class="subadmin-toolbar-initial" aria-hidden="true">{{ link.title|striptags|trim|slice(0, 1)|upper }}</span>
  {% endif %}
{% endmacro %}

{% macro render_menu_items(items, is_root, indicator, with_title) %}
  {% import _self as macros %}
  {% for link in items %}
    {# A parent without a URL (stored as "#") is only a wrapper: it opens its submenu and goes nowhere. #}
    {% set is_linked = link.url and link.url != '#' %}
    <li class="{{ is_root ? 'subadmin-toolbar-item' : 'subadmin-toolbar-subitem' }}{{ link.below ? ' has-submenu ' ~ (is_linked ? 'is-linked' : 'is-wrapper') }}">
      <a href="{{ link.url }}"{% if with_title and is_root %} title="{{ link.title|striptags }}"{% endif %} class="{{ is_root ? 'subadmin-toolbar-link' : 'subadmin-toolbar-sublink' }}">
        {{ macros.render_icon(link) }}
        <span class="subadmin-toolbar-text">{{ link.title }}</span>
        {% if link.below and not is_linked %}
          <span class="subadmin-toolbar-caret material-symbols-outlined" translate="no" aria-hidden="true">{{ is_root ? 'expand_more' : 'chevron_right' }}</span>
        {% endif %}
      </a>
      {# A linked parent gets its own button: the link navigates, the button opens the submenu. #}
      {% if link.below and is_linked %}
        <button type="button" class="subadmin-toolbar-split" aria-expanded="false" aria-label="{{ 'Toggle submenu of @title'|t({'@title': link.title}) }}">
          <span class="subadmin-toolbar-caret material-symbols-outlined" translate="no" aria-hidden="true">{{ is_root ? 'expand_more' : 'chevron_right' }}</span>
          {% if indicator == 'none' %}
            <span class="subadmin-toolbar-split-label">{{ 'Submenu'|t }}</span>
          {% endif %}
        </button>
      {% endif %}
      {% if link.below %}
        <ul class="subadmin-toolbar-submenu">
          {{ macros.render_menu_items(link.below, false, indicator, with_title) }}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
{% endmacro %}
{% import _self as macros %}

{% set position = appearance.position|default('top') %}
{% set has_collapse_toggle = position != 'top' and appearance.sidebar_mode|default('fixed') == 'collapsible' and links %}
{% if links or widgets %}
  <div id="subadmin-toolbar" class="subadmin-toolbar gin-like-toolbar" role="navigation" aria-label="{{ 'Subadmin toolbar'|t }}" data-position="{{ position }}"{% if position != 'top' %} data-sidebar-mode="{{ appearance.sidebar_mode|default('fixed') }}"{% endif %}{% if has_collapse_toggle and appearance.sidebar_start_collapsed %} data-sidebar-collapsed="true"{% endif %} data-indicator="{{ appearance.indicator|default('caret') }}"{% if appearance.submenu_icons is same as(false) %} data-submenu-icons="hidden"{% endif %} style="--subadmin-toolbar-toggle-hover-color: {{ accent_color }}; --subadmin-toolbar-accent: {{ accent_color }};{% for name, value in style_vars %} {{ name }}: {{ value }};{% endfor %}">
    <div class="subadmin-toolbar-inner">
      {% set brand %}
        {% if not hide_icon %}
          <span class="subadmin-toolbar-logo">
            {% if toolbar_icon_url %}
              <img src="{{ toolbar_icon_url }}" alt="" class="subadmin-toolbar-logo-img">
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 11a2 2 0 1 1-4 0 4 4 0 0 1 8 0 6 6 0 0 1-12 0 8 8 0 0 1 16 0 10 10 0 1 1-20 0 11.93 11.93 0 0 1 2.42-7.22 2 2 0 1 1 3.16 2.44"/></svg>
            {% endif %}
          </span>
        {% endif %}
        {% if toolbar_title %}
          <span class="subadmin-toolbar-title">{{ toolbar_title }}</span>
        {% endif %}
      {% endset %}

      <div class="subadmin-toolbar-brand">
        {% if toolbar_title_link %}
          <a href="{{ toolbar_title_link }}" class="subadmin-toolbar-title-link">{{ brand }}</a>
        {% else %}
          {{ brand }}
        {% endif %}
      </div>

      <div id="subadmin-toolbar-collapse" class="subadmin-toolbar-collapse">
        {% if links %}
          <ul id="subadmin-toolbar-menu" class="subadmin-toolbar-menu">
            {{ macros.render_menu_items(links, true, appearance.indicator|default('caret'), has_collapse_toggle and appearance.sidebar_start_collapsed) }}
          </ul>
        {% endif %}

        {% if widgets %}
          <div class="subadmin-toolbar-widgets">
            {% for widget in widgets %}
              {{ widget }}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% if has_collapse_toggle %}
        <button type="button" class="subadmin-toolbar-collapse-toggle" aria-expanded="{{ appearance.sidebar_start_collapsed ? 'false' : 'true' }}" aria-controls="subadmin-toolbar-menu">
          <span class="subadmin-toolbar-collapse-label" data-label-collapse="{{ 'Collapse menu'|t }}" data-label-expand="{{ 'Expand menu'|t }}">{{ appearance.sidebar_start_collapsed ? 'Expand menu'|t : 'Collapse menu'|t }}</span>
        </button>
      {% endif %}

      <button type="button" class="subadmin-toolbar-toggle" aria-expanded="false" aria-controls="subadmin-toolbar-collapse" aria-label="{{ 'Toggle menu'|t }}">
        <span class="subadmin-toolbar-toggle-icon" translate="no"></span>
      </button>
    </div>
  </div>
{% endif %}
