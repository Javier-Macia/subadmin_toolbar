{% macro render_icon(link) %}
	{% if link.icon %}
		{% if link.icon_type starts with 'material' %}
			<span class="subadmin-toolbar-icon {{ link.icon_type }}" translate="no">{{ link.icon }}</span>
		{% else %}
			<span class="subadmin-toolbar-icon">
				<i class="{{ link.icon_type }} {{ link.icon }}"></i>
			</span>
		{% endif %}
	{% endif %}
{% endmacro %}
{% import _self as macros %}

{% if links or widgets %}
	<div id="subadmin-toolbar" class="subadmin-toolbar gin-like-toolbar" role="navigation" aria-label="Subadministrator Toolbar" style="--subadmin-toolbar-toggle-hover-color: {{ accent_color|default('#0073ff') }}; --subadmin-toolbar-accent: {{ accent_color|default('#0073ff') }};">
		<div class="subadmin-toolbar-inner">
			<div class="subadmin-toolbar-brand">
				{% if toolbar_title_link %}
					<a href="{{ toolbar_title_link }}" class="subadmin-toolbar-title-link">
					{% endif %}

					{% if not hide_icon %}
						<span class="subadmin-toolbar-logo">
							{% if toolbar_icon_url %}
								<img src="{{ toolbar_icon_url }}" alt="Logo" style="height: 24px; width: auto; max-width: 100%; object-fit: contain;">
							{% else %}
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shell-icon lucide-shell"><path d="M14 11a2 2 0 1 1-4 0 4 4 0 0 1 8 0 6 6 0 0 1-12 0 8 8 0 0 1 16 0 10 10 0 1 1-20 0 11.93 11.93 0 0 1 2.42-7.22 2 2 0 1 1 3.16 2.44"/></svg>
							{% endif %}
						</span>
					{% endif %}

					{% if toolbar_title %}
						<span class="subadmin-toolbar-title">{{ toolbar_title|t }}</span>
					{% endif %}

					{% if toolbar_title_link %}
					</a>
				{% endif %}
			</div>

			<div id="subadmin-toolbar-collapse" class="subadmin-toolbar-collapse">
				{% if links %}
					<ul id="subadmin-toolbar-menu" class="subadmin-toolbar-menu">
						{% macro render_menu_items(items, is_root) %}
							{% import _self as macros %}
							{% for link in items %}
								<li class="{% if is_root %}subadmin-toolbar-item{% else %}subadmin-toolbar-subitem{% endif %} {% if link.below %}has-submenu{% endif %}">
									<a href="{{ link.url }}" class="{% if is_root %}subadmin-toolbar-link{% else %}subadmin-toolbar-sublink{% endif %}">
										{{ macros.render_icon(link) }}
										<span class="subadmin-toolbar-text">{{ link.title }}</span>
										{% if link.below %}
											<span class="subadmin-toolbar-caret material-symbols-outlined" translate="no">
												{% if is_root %}expand_more{% else %}chevron_right
												{% endif %}
											</span>
										{% endif %}
									</a>

									{% if link.below %}
										<ul class="subadmin-toolbar-submenu">
											{{ macros.render_menu_items(link.below, false) }}
										</ul>
									{% endif %}
								</li>
							{% endfor %}
						{% endmacro %}

						{{ macros.render_menu_items(links, true) }}
					</ul>
				{% endif %}

				{% if widgets %}
					<div class="subadmin-toolbar-widgets">
						{% for widget in widgets %}
							{{ widget }}
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<button class="subadmin-toolbar-toggle" aria-expanded="false" aria-controls="subadmin-toolbar-collapse">
				<span class="subadmin-toolbar-toggle-icon" translate="no"></span>
			</button>
		</div>
	</div>
{% endif %}
