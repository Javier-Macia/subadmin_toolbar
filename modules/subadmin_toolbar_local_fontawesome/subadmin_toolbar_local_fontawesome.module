<?php

/**
 * @file
 * Primary module hooks for Subadmin Toolbar Local Font Awesome submodule.
 */

/**
 * Implements hook_library_info_alter().
 *
 * Replaces the remote Cloudflare Font Awesome CDN library definition
 * in subadmin_toolbar with the local resource provided by native_fontawesome.
 */
function subadmin_toolbar_local_fontawesome_library_info_alter(&$libraries, $extension) {
  if ($extension === 'subadmin_toolbar' && isset($libraries['font_awesome'])) {
    // Strip remote CDN stylesheets.
    $libraries['font_awesome']['css']['theme'] = [];

    // Delegate to the standalone local native_fontawesome module.
    $libraries['font_awesome']['dependencies'][] = 'native_fontawesome/fontawesome';
  }
}
