<?php

/**
 * @file
 * Primary module hooks for Subadmin Toolbar module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function subadmin_toolbar_help(string $route_name, RouteMatchInterface $route_match): ?string {
  if ($route_name === 'help.page.subadmin_toolbar') {
    return '<p>' . t('Provides a horizontal toolbar for secondary roles. Configure its links, widgets and appearance under <a href=":url">Configuration &gt; User interface &gt; Subadmin Toolbar</a>, then grant the %permission permission to the roles that should see it.', [
      ':url' => Url::fromRoute('subadmin_toolbar.settings')->toString(),
      '%permission' => t('Access the Subadmin Toolbar'),
    ]) . '</p>';
  }
  return NULL;
}

/**
 * Implements hook_theme().
 */
function subadmin_toolbar_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'subadmin_toolbar' => [
      'variables' => [
        'links' => [],
        'widgets' => [],
        'toolbar_title' => NULL,
        'toolbar_icon_url' => NULL,
        'accent_color' => NULL,
        'toolbar_title_link' => NULL,
        'hide_icon' => FALSE,
      ],
    ],
  ];
}

/**
 * Implements hook_page_top().
 */
function subadmin_toolbar_page_top(array &$page_top): void {
  $page_top['subadmin_toolbar'] = \Drupal::service('subadmin_toolbar.builder')->build();
}
